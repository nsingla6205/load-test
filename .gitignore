# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.gocache
# Output of the go coverage tool, specifically when used with LiteIDE
*.out

#vsa-binaries
cicd/bin


# GoLand project files
.idea/
*.env
!skaffold.env
*.dev.env.tmpl
.run/

# Private key material (e.g. kubernetes/OCI/vlm-worker/vlm-worker.oci.key.pem,
# any per-developer OCI API signing keys). Never commit private keys.
*.pem
*.key
!**/testdata/**/*.pem
!**/testdata/**/*.key

# VS Code settings
.vscode/
# Ignore .cursor except tracked triagebot config
.cursor/*
!.cursor/rules/
!.cursor/rules/*/
!.cursor/agents/
!.cursor/agents/*/
!.cursor/skills/
!.cursor/skills/*/
!.cursor/commands/
!.cursor/commands/**/
!.cursor/triagebot-agents/
!.cursor/triagebot-agents/**
!.cursor/deps/
!.cursor/state/
.cursor/deps/*
!.cursor/deps/README.md
.cursor/state/*
!.cursor/state/memory.md

# macOS specific files
.DS_Store

# Go modules
vendor/

# Log files
*.log

# Temporary files
*.tmp
*.temp
*.dump

# Build directories
bin/
build/
/kubernetes/charts/*.tgz

artifacts/
app/
triagebot_logs/
.gcloud/
.toolchain/
.gomodcache/
tools/safesql/safesql

# OCI local-dev per-developer state (release pointer written/used locally)
scripts/oci-local-dev/current-release.json
