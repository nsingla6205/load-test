go 1.26.6

use (
	.
	./cicd
	./core
	./database
	./hyperscaler
	./lib
	./vcm-proxy
	./vcp-core
)

// The go-workflows engine is a NetApp fork. Declare the replacement at the
// workspace level so every module (root, core, vcm-proxy, ...) that imports the
// package resolves the same fork.
replace github.com/cschleiden/go-workflows => github.com/VCP-VSA-control-Plane/go-workflows v0.0.0-20260605164658-8ef4f86f45f4

replace netapp.com/vsa/lifecycle-manager => github.com/VCP-VSA-control-Plane/vlm/lifecycle-manager v0.0.0-20260916071839-91a01a70866d

replace netapp.com/vsa/vsa-orchestrator => github.com/VCP-VSA-control-Plane/vlm/vsa-orchestrator v0.0.0-20260916071839-91a01a70866d
