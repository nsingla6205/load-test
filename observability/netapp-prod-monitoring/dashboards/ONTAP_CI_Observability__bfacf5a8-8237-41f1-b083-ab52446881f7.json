                },
                "table_template": ""
              },
              {
                "time_series_query": {
                  "unit_override": "ms",
                  "prometheus_query": "quantile by (node)(0.99,avg_over_time(custom_googleapis_com:node_volume_avg_latency{monitored_resource=\"k8s_cluster\"}[${__interval}]))",
                  "output_full_duration": true
                },
                "table_template": ""
