            "data_sets": [
              {
                "time_series_query": {
                  "time_series_query_language": "fetch global::custom.googleapis.com/v4/vsa_volume_availability\n| filter metric.volume !~ 'cep_.*'\n| filter value.vsa_volume_availability < 99.9\n| filter value.vsa_volume_availability >= 0.0\n| top_by [], 100, mean(value.vsa_volume_availability)\n| absent_for 24h",
