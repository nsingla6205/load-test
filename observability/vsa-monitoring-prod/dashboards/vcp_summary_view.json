{
  "displayName": "VCP Summary View Dashboard",
  "dashboardFilters": [
    {
      "filterType": "RESOURCE_LABEL",
      "labelKey": "location",
      "templateVariable": "",
      "valueType": "STRING_ARRAY"
    }
  ],
  "description": "Dashboard to monitor health of key components of VCP. Only high priority workflows are monitored by the widgets in the dashboard. \n1) Monitor health of control plane\n2) Workflow failure\n3) Activity failure\n4) Workflow latency\n5) Activity latency\n\n",
  "labels": {},
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "height": 15,
        "width": 48,
        "widget": {
          "title": "Dashboard Details",
          "text": {
            "content": "\nThis dasboard gives a high level overview of the health of VCP control plane service.\n\n## High Level Dashboard\n\n    1. API health per region\n\n\n## Dashboard Description\n\n    1. API health per region - Percentage of successful API requests (non-5xx) in each region.",
            "format": "MARKDOWN",
            "style": {
              "backgroundColor": "#FFFFFF",
              "fontSize": "FS_LARGE",
              "horizontalAlignment": "H_LEFT",
              "padding": "P_EXTRA_SMALL",
              "pointerLocation": "POINTER_LOCATION_UNSPECIFIED",
              "textColor": "#212121",
              "verticalAlignment": "V_TOP"
            }
          }
        }
      },
      {
        "yPos": 15,
        "height": 23,
        "width": 48,
        "widget": {
          "title": "API Health Status",
          "id": "",
          "xyChart": {
            "chartOptions": {
              "displayHorizontal": false,
              "mode": "COLOR",
              "showLegend": false
            },
            "dataSets": [
              {
                "breakdowns": [],
                "dimensions": [],
                "legendTemplate": "",
                "measures": [],
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "sort": [],
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "outputFullDuration": false,
                  "timeSeriesFilterRatio": {
                    "numerator": {
                      "aggregation": {
                        "alignmentPeriod": "60s",
                        "crossSeriesReducer": "REDUCE_SUM",
                        "groupByFields": [
                          "resource.label.\"location\""
                        ],
                        "perSeriesAligner": "ALIGN_RATE"
                      },
                      "filter": "metric.type=\"custom.googleapis.com/ogen_server_request_count_total\" resource.type=\"k8s_cluster\" metric.label.\"http_response_status_code\"!=monitoring.regex.full_match(\"5.*\")"
                    },
                    "denominator": {
                      "aggregation": {
                        "crossSeriesReducer": "REDUCE_SUM",
                        "groupByFields": [
                          "resource.label.\"location\""
                        ],
                        "perSeriesAligner": "ALIGN_RATE"
                      },
                      "filter": "metric.type=\"custom.googleapis.com/ogen_server_request_count_total\" resource.type=\"k8s_cluster\""
                    }
                  },
                  "unitOverride": ""
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      }
    ]
  }
}