        "widget": {
          "title": "Dashboard Details",
          "text": {
            "content": "This dashboard gives a high-level view of who is calling the ONTAP proxy, from which pools/projects, and which API paths are used across the fleet. \nIt shows the health of the ONTAP Proxy  at a glance.\n\n# High Level Dashboards\n\n    1. Operations specific views\n    2. Region specific views\n    3. Customer specific views\n\n\n## Activity Summary\n\n    1. API level summary(http)\n    2. Backend level summary\n    3. Cache workflow related summary\n",
            "format_": 1,
            "style": {
              "background_color": "#FFFFFF",
              "text_color": "#212121",
              "horizontal_alignment": 1,
              "vertical_alignment": 1,
              "padding": 1,
              "font_size": 4,
              "pointer_location": 0
            }
          },
          "id": ""
        },
        "x_pos": 0,
        "y_pos": 0
      },
