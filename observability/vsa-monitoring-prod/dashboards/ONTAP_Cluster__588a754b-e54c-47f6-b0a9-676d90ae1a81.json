          "title": "Cluster",
          "time_series_table": {
            "data_sets": [
              {
                "time_series_query": {
                  "time_series_filter": {
                    "filter": "metric.type=\"custom.googleapis.com/cluster_new_status\" resource.type=\"k8s_cluster\" metric.label.\"pool_name\"!=monitoring.regex.full_match(\"cep-.*\")",
                    "aggregation": {
                      "alignment_period": "60s",
                      "per_series_aligner": 12,
                      "cross_series_reducer": 4,
                      "group_by_fields": [
                        "metric.label.\"project\"",
                        "metric.label.\"tenant_project\"",
                        "metric.label.\"pool_name\"",
                        "metric.label.\"cluster\"",
                        "resource.label.\"location\"",
                        "metric.label.\"status\""
