            "style": {
              "background_color": "#FFFFFF",
              "text_color": "#212121",
              "horizontal_alignment": 1,
              "vertical_alignment": 1,
              "padding": 1,
              "font_size": 4,
              "pointer_location": 0
            }
          },
          "id": ""
        },
        "x_pos": 0,
        "y_pos": 0
