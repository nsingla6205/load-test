            "data_sets": [
              {
                "time_series_query": {
                  "time_series_filter": {
                    "filter": "metric.type=\"custom.googleapis.com/ogen.server.request_count_total\" resource.type=\"k8s_cluster\" metric.label.\"oas_operation\"!=monitoring.regex.full_match(\"getHealth|v1beta_describeOperation\") metric.label.\"Job_State\"=\"DONE\" metric.label.\"Job_Type\"!=monitoring.regex.full_match(\".*INTERNAL*.\")",
                    "aggregation": {
                      "alignment_period": "60s",
                      "per_series_aligner": 1,
