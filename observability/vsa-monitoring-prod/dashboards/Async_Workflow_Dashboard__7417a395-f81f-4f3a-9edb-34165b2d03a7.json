        "widget": {
          "title": "Dashboard Details",
          "text": {
            "content": "This dashboard give a high level summary of who is executing, where and which workflows accross the fleet.\nProvides health of the service at a glance\n\n# High Level Dashboards (Leadership)\n\n    1. Customer centric views\n    2. Region specific views\n    3. Workflow centric views\n\n\n## Workflow Summary\n\n    1. Usage of the workflows accross the fleet\n    2. Availability of the Workflows\n    3. Error rate in each Workflow\n    4. Latency in executing the workflows",
            "format_": 1,
            "style": {
              "background_color": "#FFFFFF",
              "text_color": "#212121",
              "horizontal_alignment": 1,
              "vertical_alignment": 1,
              "padding": 1,
              "font_size": 4,
              "pointer_location": 0
            }
          },
          "id": ""
        },
        "x_pos": 0,
        "y_pos": 0
      },
