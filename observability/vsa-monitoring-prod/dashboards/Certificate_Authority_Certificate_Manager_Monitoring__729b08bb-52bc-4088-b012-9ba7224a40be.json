      {
        "y_pos": 18,
        "width": 24,
        "height": 20,
        "widget": {
          "title": "CA inventory: days until certificate expiry",
          "time_series_table": {
            "data_sets": [
              {
                "time_series_query": {
                  "unit_override": "s",
                  "prometheus_query": "avg by (\"ca_pool_id\",\"certificate_authority_id\",${__groupby})(avg_over_time({\"__name__\"=\"privateca.googleapis.com/ca/cert_expiration\",\"monitored_resource\"=\"privateca.googleapis.com/CertificateAuthority\"}[${__interval}]))",
                  "output_full_duration": false
                },
                "min_alignment_period": "60s",
                "table_template": ""
              }
            ],
            "metric_visualization": 2,
            "column_settings": [
              {
                "column": "ca_pool_id",
                "visible": true
              },
              {
                "column": "certificate_authority_id",
                "visible": true
              },
              {
                "column": "value",
                "visible": true
              }
            ]
          },
          "id": ""
        },
        "x_pos": 0
      },
      {
        "x_pos": 24,
        "y_pos": 18,
        "width": 24,
        "height": 20,
        "widget": {
          "title": "CA inventory: Disabled state by pool",
          "time_series_table": {
            "data_sets": [
              {
                "time_series_query": {
                  "time_series_filter": {
                    "filter": "metric.type=\"privateca.googleapis.com/ca/resource_state\" resource.type=\"privateca.googleapis.com/CertificateAuthority\" resource.label.\"certificate_authority_id\"!=monitoring.regex.full_match(\".*-root-.*\") metric.label.\"state\"=\"DISABLED\"",
                    "aggregation": {
                      "alignment_period": "60s",
                      "per_series_aligner": 17,
                      "cross_series_reducer": 1,
                      "group_by_fields": [
                        "metric.label.\"state\"",
                        "resource.label.\"location\"",
                        "resource.label.\"ca_pool_id\"",
                        "resource.label.\"certificate_authority_id\""
                      ]
                    }
                  },
                  "unit_override": "",
                  "output_full_duration": false
                },
                "min_alignment_period": "60s",
                "table_template": ""
              }
            ],
            "metric_visualization": 1,
            "column_settings": [
              {
                "column": "state",
                "visible": true
              },
              {
                "column": "ca_pool_id",
                "visible": true
              },
              {
                "column": "project_id",
                "visible": false
              },
              {
                "column": "location",
                "visible": true
              },
              {
                "column": "certificate_authority_id",
                "visible": true
              },
              {
                "column": "value",
                "visible": false
              }
            ]
          },
          "id": ""
        }
